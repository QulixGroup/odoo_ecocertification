<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Certificate Type Action -->
    <record id="environment_certificate_types_action" model="ir.actions.act_window">
        <field name="name">Certificate Types</field>
        <field name="res_model">environment.certificate.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="environment_certificate_type_form_view" model="ir.ui.view">
        <field name="name">environment.certificate.type.form</field>
        <field name="model">environment.certificate.type</field>
        <field name="arch" type="xml">
            <form string="Certificate Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="environment_certificate_type_list_view" model="ir.ui.view">
        <field name="name">environment.certificate.type.list</field>
        <field name="model">environment.certificate.type</field>
        <field name="arch" type="xml">
            <list string="Certificate Types" editable="top">
                <field name="name"/>
            </list>
        </field>
     </record>

    <menuitem id="res_partner_certificates_menu" name="Certificate Types"
        action="environmental_certificates.environment_certificate_types_action"
        parent="contacts.res_partner_menu_config"
        sequence="5"/>
</odoo>