<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherited form view -->
        <record id="res_partner_view_form" model="ir.ui.view">
            <field name="name">res.partner.view.form.inherit.environment.certificate</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//notebook/page[@name='internal_notes']" position="after">
                        <page string="Environmental Certificates">
                            <group>
                                <button name="action_add_certificate" 
                                        string="Add Certificate"
                                        type="object"
                                        class="btn-primary"
                                        icon="fa-plus"/>
                            </group>
                            <field name="certificate_ids" nolabel="1">
                                <list create="false" delete="true" editable="bottom" edit="0">
                                    <field name="id"/>
                                    <field name="type_id"/>
                                    <field name="color" widget="html"/>
                                    <field name="expiration_date"/>
                                    <field name="download_url" widget="html" string="Download"/>
                                    <button name="action_edit_certificate" 
                                            type="object" 
                                            icon="fa-pencil" 
                                            string="Edit"/>
                                </list>
                            </field>
                        </page>
                    </xpath>
                </data>
            </field>
        </record>
        <!-- Inherited search view -->
        <record id="res_partner_search_form" model="ir.ui.view">
            <field name="name">res.partner.view.search.inherit.environment.certificate</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//*[@name='inactive']" position="after">
                        <filter name="valid" string="Expired"
                        domain="[('certificate_ids.status', '=', 'expired')]"/>
                    </xpath>
                </data>

            </field>
        </record>
    </data>
</odoo>